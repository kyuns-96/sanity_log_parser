# Copy the variable names into a private .env beside this file.
# Fill real values locally; never paste them into logs or source code.
SANITY_DB_ACCESS=postgresql
SANITY_DB_HOST=
SANITY_DB_PORT=5432
SANITY_DB_NAME=
# Each deployment uses its OWN restricted login: VWP on VWP, OA on OA.
SANITY_DB_USER_NAME=
SANITY_DB_PASSWORD=
SANITY_DB_SCHEMA=public
# Match the DBA's TLS policy. No automatic downgrade on connection failure.
SANITY_DB_SSLMODE=verify-full
# Absolute root CA file path if required by the server's certificate chain.
SANITY_DB_SSLROOTCERT=

# Optional legacy/test DSNs: a non-empty side DSN overrides the DB fields above.
# SANITY_VWP_DSN=
# SANITY_OA_DSN=

# Legacy temporary READ-ONLY HTTP access only; not needed for PostgreSQL.
# SANITY_DB_ACCESS=dbaas_http
# DBAAS_BASE_URL=
# DBAAS_TOKEN=
# DBAAS_CA_PATH=

# Dashboard authentication: local_token (existing single-user prototype) or sso.
# SSO requires injected company adapters; no fallback to the local token.
# See oa-bridge/SSO_INTEGRATION.md and oa-bridge/sso_app.py.
SANITY_AUTH_MODE=local_token
# Local-only dashboard: use a private random token (at least 32 characters).
# Never put either DB credentials or this token in VITE_* variables.
SANITY_DASHBOARD_TOKEN=
SANITY_DASHBOARD_REVIEWER=

# VWP only. Full HTTPS endpoint including /v1/chat/completions or /v1/responses.
# No default service/model, no automatic API/CLI fallback. Never use VITE_*.
SANITY_AI_MODE=disabled
SANITY_AI_URL=
SANITY_AI_TOKEN=
SANITY_AI_MODEL=
SANITY_AI_API=chat_completions
# Enable only if the server supports JSON object mode; output is always validated.
SANITY_AI_JSON_MODE=off
SANITY_AI_TIMEOUT=120
SANITY_AI_CA_PATH=
# Optional CLI: JSON argv array with absolute executable path, no shell.
SANITY_AI_ARGV=
