# OA ONLY. Copy keys into private .env at the Git checkout root (one level above this file).
# Enter the separately issued OA login, a member of sanity_oa_app.
# Shared-login deployments: see db/CONNECTION_HANDOFF.md section 3.1.
SANITY_DB_ACCESS=postgresql
SANITY_DB_ALLOW_SINGLE_ACCOUNT=false
SANITY_DB_HOST=
SANITY_DB_PORT=5432
SANITY_DB_NAME=
SANITY_DB_USER_NAME=
SANITY_DB_PASSWORD=
SANITY_DB_SCHEMA=public
SANITY_DB_SSLMODE=verify-full
SANITY_DB_SSLROOTCERT=
# A non-empty SANITY_OA_DSN overrides host/user/password/port/TLS fields.
# SANITY_OA_DSN=

# Company SSO entry point is python -m oa.sso_app; corporate adapters are required.
SANITY_AUTH_MODE=sso
# One verified SSO LocalUser.user_id; empty keeps production RBAC disabled.
# Management privileges do not grant access to report data. Set privately.
SANITY_ADMIN_USER_ID=

# OA AI: complete-input classification/review through a private compatible API.
# URL is the full HTTPS method endpoint; credentials stay server-side.
SANITY_OA_AI_ENABLED=false
SANITY_OA_AI_URL=
SANITY_OA_AI_TOKEN=
# server: use the token above; user: each SSO user registers their own token.
# In user mode the server token is ignored. Web and worker share one private Fernet key.
SANITY_OA_AI_TOKEN_SOURCE=server
SANITY_OA_AI_TOKEN_STORE_SECRET=
# Optional HTTPS token issuance page shown in the personal token dialog (public to signed-in users).
SANITY_OA_AI_TOKEN_ISSUE_URL=
SANITY_OA_AI_MODEL=
SANITY_OA_AI_API=chat_completions
SANITY_OA_AI_JSON_MODE=false
SANITY_OA_AI_TIMEOUT=120
# Wire byte guards are not model token/context limits. Overflow fails explicitly.
SANITY_OA_AI_MAX_INPUT_BYTES=1048576
SANITY_OA_AI_MAX_OUTPUT_BYTES=2097152
# Optional absolute private CA and operator-approved criterion catalog paths.
SANITY_OA_AI_CA_PATH=
SANITY_OA_AI_CRITERIA_FILE=
# Optional company gateway: configure all three client values together.
# The extra header name is fixed to x-client-api-key. No arbitrary header/body settings.
SANITY_OA_AI_CLIENT_API_KEY=
SANITY_OA_AI_CLIENT_NAME=
SANITY_OA_AI_CLIENT_VERSION=
# disabled (no gateway), per_request (fresh UUID per call), or fixed (requires SESSION_ID).
# The confirmed stateless company gateway supports per_request; set it explicitly for that deployment.
SANITY_OA_AI_SESSION_MODE=disabled
SANITY_OA_AI_SESSION_ID=
