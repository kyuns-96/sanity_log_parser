# The build context is the repository root. Include runtime sources only.
**
!common/
!common/**
!oa/
!oa/**

# Support a standalone root docker/ layout with only its runtime bootstrap.
!docker/
docker/**
!docker/start.py
!docker/nginx-main.conf
!docker/nginx.conf

# These exclusions also apply under the allowlisted directories.
**/.env
**/.env.*
**/.npmrc
**/pip.conf
**/*secret*
**/*credential*
**/dbaccess.md
**/*.pem
**/*.key
**/*.cer
**/*.crt
**/*.p12
**/*.pfx
**/certs/**
**/.venv/**
**/node_modules/**
**/dist/**
**/__pycache__/**
**/*.py[cod]
**/*.swp
**/*.swo
**/*~
**/*.log
**/artifacts/**
**/reports/**
**/snapshots/**
**/fixtures/**
**/test_*.py
**/tests/**
**/e2e/**
**/test-results/**
**/playwright-report/**
**/public/sample-data/**
