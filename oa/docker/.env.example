# Compose/build settings only. Put real DB/SSO credentials in OA_ENV_FILE.
# Replace these with approved company registry image references.
# Both may point to the same company Node 20.18 / Python 3.10 image.
OA_BASE_IMAGE=python:3.10-slim-bookworm
OA_NODE_IMAGE=node:20.18.0-bookworm-slim
OA_IMAGE=sanity-oa:local
OA_ENV_FILE=/srv/sanity-oa/oa.env
# Exact browser/ingress Host names or IPs, comma-separated, without ports.
# Example company name for local documentation: oa.example.invalid
OA_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Only needed with compose.ca.yaml. Runtime path: /run/sanity-ca/<CA filename>.
# OA_CA_DIR=/srv/sanity-oa/certs
