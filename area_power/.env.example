# Optional Area/Power module. One VWP server environment owns uploads, numerical jobs, and AI jobs.
# OA retains its existing authentication/SSO settings; this file does not replace them.
# Shared OA/VWP database settings: keep private and supply to both roles as required.
AREA_POWER_DB_DSN=
AREA_POWER_DB_SCHEMA=
# Central VWP AI connection; the API key is optional and used only when the provider requires Bearer authentication.
AREA_POWER_AI_BASE_URL=
AREA_POWER_AI_MODEL=
# Optional: leave empty unless this AI provider requires Bearer authentication.
AREA_POWER_AI_API_KEY=
# OA-only feature flag and mail recipient configuration.
AREA_POWER_ENABLED=false
AREA_POWER_MAIL_RECIPIENTS=
# User PC only; no database or model credentials.
AREA_POWER_SERVER_URL=
