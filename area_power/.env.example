# Optional Area/Power module. Export only the keys needed by each server.
# Host OA authentication remains SANITY_AUTH_MODE / the existing SSO configuration.
# No separate Area/Power browser token or trusted X-Actor exists.
AREA_POWER_ENABLED=false
AREA_POWER_DB_DSN=
AREA_POWER_DB_SCHEMA=
# User PC -> central VWP upload service only, not OA -> VWP communication.
AREA_POWER_UPLOAD_TOKEN=
AREA_POWER_MAX_UPLOAD_BYTES=33554432
AREA_POWER_MAX_UNCOMPRESSED_BYTES=268435456
AREA_POWER_WORKER_POLL_SECONDS=2
# VWP analysis worker only; never distribute model secrets to user PCs.
AREA_POWER_AI_BASE_URL=
AREA_POWER_AI_API_KEY=
AREA_POWER_AI_MODEL=
AREA_POWER_AI_TIMEOUT_SECONDS=90
AREA_POWER_AI_CONTEXT_MAX_CHARS=48000
# OA mail worker only. SMTP acceptance is not recipient delivery/read status.
AREA_POWER_SMTP_HOST=
AREA_POWER_SMTP_PORT=587
AREA_POWER_SMTP_FROM=
AREA_POWER_SMTP_USERNAME=
AREA_POWER_SMTP_PASSWORD=
AREA_POWER_SMTP_STARTTLS=true
AREA_POWER_SMTP_SSL=false
AREA_POWER_SMTP_RECIPIENTS=
# User PC only; no database or model credentials.
AREA_POWER_SERVER_URL=
AREA_POWER_ACTOR=
