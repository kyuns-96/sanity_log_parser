# Compose/build settings only. Put real VWP DB values in VWP_BRIDGE_ENV_FILE.
# Model settings are only needed for the separate legacy VWP AI worker.
# Replace this with the approved company Python 3.10+ image reference.
# The same company Node 20.18 / Python image used for OA can be specified here.
VWP_BRIDGE_BASE_IMAGE=python:3.10-slim-bookworm
# Replace with the approved company Nexus/PyPI simple index URL. No credentials.
# The public default is for external development only, as with the base image.
VWP_BRIDGE_PIP_INDEX=https://pypi.org/simple
# Only when this directory is deployed at company repository root as docker/:
# VWP_BRIDGE_BUILD_CONTEXT=..
# VWP_BRIDGE_DOCKERFILE=docker/Dockerfile-prod
VWP_BRIDGE_IMAGE=sanity-vwp-bridge:local

# HTTPS submission with DB originals: use compose.https.yaml, no archive mount.
# Worker-only parsing scratch. Must fit the restored submission; not a persistent archive.
# VWP_SUBMISSION_TMP_SIZE=512m
# VWP_SUBMISSION_TLS_DIR=/private/sanity-submission-tls
# VWP_SUBMISSION_BIND_IP=192.0.2.10
# VWP_SUBMISSION_HTTPS_PORT=8443
VWP_BRIDGE_ENV_FILE=/srv/sanity-vwp-bridge/vwp-bridge.env
# Central intake: only needed with compose.submission.yaml. Paths must exist.
# JSON must use service_uid=10001 and the fixed container spool/archive paths.
# VWP_SUBMISSION_CONFIG_FILE=/etc/sanity/vwp-bridge-submit.json
# VWP_SUBMISSION_SPOOL_DIR=/srv/sanity/vwp-submit
# VWP_SUBMISSION_ARCHIVE_DIR=/var/lib/sanity/vwp-bridge/submissions
# Only needed with compose.ca.yaml. Runtime path: /run/sanity-ca/<CA filename>.
# VWP_BRIDGE_CA_DIR=/srv/sanity-vwp-bridge/certs
# Only needed with compose.analysis.yaml. Both host directories must exist.
# VWP_BRIDGE_SNAPSHOT_DIR=/srv/sanity-vwp-bridge/snapshots
# VWP_BRIDGE_RECEIPT_DIR=/srv/sanity-vwp-bridge/receipts
