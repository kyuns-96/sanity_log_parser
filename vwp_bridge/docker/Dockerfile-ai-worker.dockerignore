# Repository-root context: only the worker packages and dependency manifest.
**
!common/
!common/**
!oa/
!oa/*.py
!oa/requirements.txt
!oa/integration/
!oa/integration/**

# Apply these exclusions inside the allowlisted directories too.
**/.env
**/.env.*
**/.npmrc
**/pip.conf
**/*secret*
**/*credential*
**/*.private.*
**/dbaccess.md
**/*.pem
**/*.key
**/*.cer
**/*.crt
**/*.p12
**/*.pfx
**/certs/**
**/.venv/**
**/node_modules/**
**/dist/**
**/__pycache__/**
**/*.py[cod]
**/*.swp
**/*.swo
**/*~
**/*.log
**/*.rpt
**/artifacts/**
**/reports/**
**/snapshots/**
**/fixtures/**
**/test_*.py
**/tests/**
**/test-results/**
**/playwright-report/**
