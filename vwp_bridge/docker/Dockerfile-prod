# Like OA, place this file and its Dockerfile-prod.dockerignore at company root
# docker/ beside common/ and vwp_bridge/. Build with that root as context.
# In this combined repository:
# docker build -f vwp_bridge/docker/Dockerfile-prod -t sanity-vwp-bridge:local .
# Use the approved company Python image (a Node/Python image is also supported).
ARG VWP_BRIDGE_BASE_IMAGE=python:3.10-slim-bookworm
ARG VWP_BRIDGE_PIP_INDEX=https://pypi.org/simple

FROM ${VWP_BRIDGE_BASE_IMAGE} AS python-dependencies
ARG VWP_BRIDGE_PIP_INDEX
USER 0
WORKDIR /build
COPY vwp_bridge/requirements.txt ./requirements.txt
RUN python3 -m venv /opt/venv
# The index argument contains only a public/non-secret mirror URL. An optional
# private pip config takes precedence and stays in a BuildKit secret mount.
RUN --mount=type=secret,id=pip_config,target=/run/secrets/pip.conf \
    unset PIP_INDEX_URL PIP_EXTRA_INDEX_URL PIP_TRUSTED_HOST; \
    if [ -f /run/secrets/pip.conf ]; then \
        PIP_CONFIG_FILE=/run/secrets/pip.conf \
            /opt/venv/bin/python -m pip install --no-cache-dir -r requirements.txt; \
    else \
        /opt/venv/bin/python -m pip install --no-cache-dir \
            --index-url "${VWP_BRIDGE_PIP_INDEX}" -r requirements.txt; \
    fi

FROM ${VWP_BRIDGE_BASE_IMAGE} AS runtime
USER 0
WORKDIR /opt/work
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY --from=python-dependencies /opt/venv/ /opt/venv/
COPY common/ ./common/
COPY vwp_bridge/*.py ./vwp_bridge/
COPY vwp_bridge/integration/ ./vwp_bridge/integration/
USER 10001:10001
# CLI, DB worker and explicit HTTPS ingress share this image; discard inherited checks.
HEALTHCHECK NONE
ENTRYPOINT []
# Starting the image alone displays usage without accessing the DB or model.
CMD ["python", "-m", "vwp_bridge.main", "--help"]
