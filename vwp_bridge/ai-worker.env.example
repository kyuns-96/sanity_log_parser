# VWP-hosted logical OA job worker. Keep actual values in a private env file.
# This deployment already uses one login for both sides. Preserve explicit mode.
SANITY_DB_ACCESS=postgresql
SANITY_DB_ALLOW_SINGLE_ACCOUNT=true
SANITY_DB_HOST=
SANITY_DB_PORT=5432
SANITY_DB_NAME=
SANITY_DB_USER_NAME=
SANITY_DB_PASSWORD=
SANITY_DB_SCHEMA=public
SANITY_DB_SSLMODE=verify-full
SANITY_DB_SSLROOTCERT=/run/sanity-ai/db-ca.pem
# Do not set an OA-only DSN here unless it is the same approved shared login.
# SANITY_OA_DSN=
# Current administrator's stable SSO identity, as on OA.
SANITY_ADMIN_USER_ID=
# Same existing OA encryption key ONLY when this worker handles OA personal
# tokens. VWP profile credentials use the local profile file instead.
SANITY_OA_AI_TOKEN_STORE_SECRET=
SANITY_VWP_AI_PROFILES_FILE=/run/sanity-ai/profiles.json
