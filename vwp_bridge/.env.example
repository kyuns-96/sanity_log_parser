# VWP-bridge ONLY. Copy keys into private .env at the Git checkout root (one level above this file).
# Enter the separately issued VWP login, a member of sanity_vwp_app.
# Shared-login deployments: see db/CONNECTION_HANDOFF.md section 3.1.
SANITY_DB_ACCESS=postgresql
SANITY_DB_ALLOW_SINGLE_ACCOUNT=false
SANITY_DB_HOST=
SANITY_DB_PORT=5432
SANITY_DB_NAME=
SANITY_DB_USER_NAME=
SANITY_DB_PASSWORD=
SANITY_DB_SCHEMA=public
SANITY_DB_SSLMODE=verify-full
SANITY_DB_SSLROOTCERT=
# A non-empty SANITY_VWP_DSN overrides host/user/password/port/TLS fields.
# SANITY_VWP_DSN=

# Legacy VWP model configuration only; new company SDK injection is separate.
SANITY_AI_MODE=disabled
# Full HTTP or HTTPS model endpoint.
SANITY_AI_URL=
SANITY_AI_TOKEN=
SANITY_AI_MODEL=
SANITY_AI_API=chat_completions
SANITY_AI_JSON_MODE=off
SANITY_AI_TIMEOUT=120
SANITY_AI_CA_PATH=
SANITY_AI_ARGV=
